// Samad Traders — database schema (Prisma 6 + Supabase Postgres)
// After editing, run:  npm run db:push   then   npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Top-level department a category belongs to. Drives the main nav + filters.
enum Department {
  ELECTRIC
  SANITARY
  FANCY_LIGHTS
}

enum OrderStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  NEW
  RESPONDED
  CLOSED
}

enum InquiryStatus {
  NEW
  READ
  RESOLVED
}

/// A product brand (e.g. a switch or fittings manufacturer).
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  /// Percentage taken off this brand's list prices in the instant quotation
  /// (e.g. 12.5 = 12.5% off). Set daily from Admin → Brands.
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

/// A product category (e.g. "Wall Switches", "Bathroom Faucets", "Chandeliers").
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  department  Department
  description String?    @db.Text
  imageUrl    String?
  /// Manual ordering in menus (lower = first).
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department])
  @@index([slug])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  /// Short one-line summary shown in listings and meta descriptions.
  shortDesc   String?
  description String?        @db.Text
  /// Current selling price (PKR). Change this daily from the admin panel.
  price       Decimal        @db.Decimal(12, 2)
  /// Optional "was" price to show a discount (strike-through).
  oldPrice    Decimal?       @db.Decimal(12, 2)
  /// Unit the price is for, e.g. "per piece", "per meter", "per set".
  unit        String         @default("per piece")
  sku         String?        @unique
  /// Free-form spec pairs, e.g. [{ "label": "Wattage", "value": "9W" }].
  specs       Json?
  inStock     Boolean        @default(true)
  featured    Boolean        @default(false)
  isActive    Boolean        @default(true)

  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?         @relation(fields: [brandId], references: [id])

  images      ProductImage[]
  orderItems  OrderItem[]
  quoteItems  QuotationItem[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([featured])
  @@index([isActive])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders — a customer places an order directly on the site.
// ---------------------------------------------------------------------------
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  email        String?
  address      String
  city         String      @default("Lahore")
  notes        String?     @db.Text
  status       OrderStatus @default(NEW)
  /// Snapshot of the cart total at order time (PKR).
  total        Decimal     @db.Decimal(12, 2)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  /// Snapshot so the order stays accurate even if the product later changes.
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Quotations — a customer requests a price quote for a list of items.
// ---------------------------------------------------------------------------
model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique
  customerName String
  phone        String
  email        String?
  message      String?         @db.Text
  status       QuotationStatus @default(NEW)
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Contact inquiries — the "Contact us" form.
// ---------------------------------------------------------------------------
model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Admin users — who can log in to the admin panel.
// ---------------------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Editable shop settings (contact info, hours, map) — a single row (id="main").
// Overrides the defaults in src/config/site.ts when present.
// ---------------------------------------------------------------------------
model Setting {
  id           String   @id @default("main")
  shopName     String?
  phone        String?
  /// Optional second contact number (e.g. a mobile alongside the landline).
  phone2       String?
  whatsapp     String?
  /// Optional custom wa.me short link. When set, the WhatsApp buttons use this
  /// instead of building a link from the number.
  whatsappLink String?
  email        String?
  address      String?
  mapEmbedUrl  String?
  mapLink      String?
  facebook     String?
  instagram    String?
  updatedAt    DateTime @updatedAt
}

/// An official certificate / authorisation from a brand or company, shown on
/// the About page. Managed from Admin → Certificates.
model Certificate {
  id          String   @id @default(cuid())
  /// Company or brand name, e.g. "Popular Pipes".
  name        String
  /// Company logo shown on the button.
  logoUrl     String?
  /// The certificate itself (image or PDF) opened when the button is clicked.
  fileUrl     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
